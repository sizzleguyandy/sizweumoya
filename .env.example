RAC_DB_PATH=data/runners.db
PUBLIC_BASE_URL=https://your-domain.example

# Strava app (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=pick-a-random-string
# From 2027-06-01: STRAVA_API_BASE=https://www.api-v3.strava.com
STRAVA_API_BASE=https://www.strava.com/api/v3

# Hermes gateway (API server) and Telegram
HERMES_BASE_URL=http://127.0.0.1:8642
TELEGRAM_BOT_TOKEN=
COACH_CHAT_ID=

# MCP identity
MCP_PROFILE_HEADER=x-hermes-profile
MCP_PORT=8100
COACH_PROFILE=coach
COACH_MCP_TOKEN_HASH=

# Protects /jobs/* endpoints (call them from cron)
JOBS_TOKEN=
