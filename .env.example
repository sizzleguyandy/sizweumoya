RAC_DB_PATH=data/runners.db

# Hermes gateway (API server) and Telegram
HERMES_BASE_URL=http://127.0.0.1:8642
TELEGRAM_BOT_TOKEN=
COACH_CHAT_ID=

# MCP identity
MCP_PROFILE_HEADER=x-hermes-profile
MCP_PORT=8100
COACH_PROFILE=coach
COACH_MCP_TOKEN_HASH=

# Protects /jobs/* endpoints (call them from cron)
JOBS_TOKEN=

# Where Hermes keeps each profile's files (attachments runners send to the bot).
# {profile} is the authenticated profile name, so a runner can only submit their own files.
HERMES_HOME=C:\Users\andre\AppData\Local\hermes
UPLOAD_ROOT={hermes_home}/profiles/{profile}

# Intervals.icu: automatic debriefs for synced runs (0 until its API terms are checked)
INTERVALS_AI_ALLOWED=0

# Programme form (Google Form) Sarah sends to runners on the programme plan
DEX_FORM_URL=

# Join alert: the Hermes gateway log, and (if the default doesn't fit) a regex with a named
# group chat_id (and optionally name) matching the line logged when an unknown person is declined
JOIN_LOG_FILE=
JOIN_LOG_PATTERN=

# Only with a paid Open-Meteo plan (commercial use); empty = the free API
OPEN_METEO_API_KEY=
